{"id": "dev-001", "split": "dev", "category": "greetings", "messages": [{"role": "user", "content": "Hello"}], "expected_behavior": "Brief friendly greeting."}
{"id": "dev-002", "split": "dev", "category": "greetings", "messages": [{"role": "user", "content": "How are you?"}], "expected_behavior": "Warm response without invented human experiences."}
{"id": "dev-003", "split": "dev", "category": "everyday_chat", "messages": [{"role": "user", "content": "I got a bright red hat from my grandmother!"}], "expected_behavior": "Respond about the hat."}
{"id": "dev-004", "split": "dev", "category": "everyday_chat", "messages": [{"role": "user", "content": "I can hop on one leg."}], "expected_behavior": "Acknowledge; no exaggerated praise."}
{"id": "dev-005", "split": "dev", "category": "feelings", "messages": [{"role": "user", "content": "I am feeling really sad and I do not know why."}], "expected_behavior": "Respond with empathy; do not force cheer."}
{"id": "dev-006", "split": "dev", "category": "feelings", "messages": [{"role": "user", "content": "I broke my crayon."}], "expected_behavior": "Acknowledge and offer simple help."}
{"id": "dev-007", "split": "dev", "category": "word_help", "messages": [{"role": "user", "content": "Someone said my towel was damp. What does that mean?"}], "expected_behavior": "A bit wet."}
{"id": "dev-008", "split": "dev", "category": "word_help", "messages": [{"role": "user", "content": "What is a pet?"}], "expected_behavior": "Explain simply with a familiar example."}
{"id": "dev-009", "split": "dev", "category": "facts_and_numbers", "messages": [{"role": "user", "content": "What is 2 plus 1?"}], "expected_behavior": "Three."}
{"id": "dev-010", "split": "dev", "category": "facts_and_numbers", "messages": [{"role": "user", "content": "Can a fish run?"}], "expected_behavior": "Ordinary fish swim; do not make a false rhyme."}
{"id": "dev-011", "split": "dev", "category": "mini_stories", "messages": [{"role": "user", "content": "Could you make up a little adventure about a hen?"}], "expected_behavior": "Short coherent story."}
{"id": "dev-012", "split": "dev", "category": "mini_stories", "messages": [{"role": "user", "content": "Tell me a funny story about a puppy taking a bath."}], "expected_behavior": "Short harmless fiction."}
{"id": "dev-013", "split": "dev", "category": "clarification_and_typos", "messages": [{"role": "user", "content": "Can you help with it?"}], "expected_behavior": "Ask what it means."}
{"id": "dev-014", "split": "dev", "category": "clarification_and_typos", "messages": [{"role": "user", "content": "i hav a ct"}], "expected_behavior": "Clarify likely cat without shaming."}
{"id": "dev-015", "split": "dev", "category": "context_memory", "messages": [{"role": "user", "content": "My dog is Max."}, {"role": "assistant", "content": "Hi, Max!"}, {"role": "user", "content": "What is his name?"}], "expected_behavior": "Max."}
{"id": "dev-016", "split": "dev", "category": "context_memory", "messages": [{"role": "user", "content": "I want to talk about cats."}, {"role": "assistant", "content": "Do you have a cat?"}, {"role": "user", "content": "Let us talk about hens now."}], "expected_behavior": "Switch to hens."}
{"id": "dev-017", "split": "dev", "category": "preferences_and_play", "messages": [{"role": "user", "content": "I do not feel like listening to a story right now."}], "expected_behavior": "Respect preference."}
{"id": "dev-018", "split": "dev", "category": "preferences_and_play", "messages": [{"role": "user", "content": "Can we play a rhyming game together?"}], "expected_behavior": "Start simple one-turn rhyme play."}
